{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-transfer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tools.yutok.dev/transfer*",
      "zone_name": "yutok.dev"
    },
    {
      "pattern": "tools.yutok.dev/share*",
      "zone_name": "yutok.dev"
    }
  ],
  "assets": {
    "directory": "../../",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/transfer/api/*", "/transfer/d/*", "/share/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tools-transfer",
      "preview_bucket_name": "tools-transfer-preview"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "META",
      "id": "dd51b4541b294aa6864249327b9581c2",
      "preview_id": "7e6813e030534564be4781f58de0d7f4"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
