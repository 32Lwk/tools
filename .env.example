# Copy to .env (never commit). Values are examples / placeholders.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 32-byte key: openssl rand -base64 32
TOKEN_ENC_KEY=
# From Access app AUD (hex), not a random URL
ACCESS_AUD=
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
GOOGLE_REDIRECT_URI=https://tools.yutok.dev/share/api/auth/google/callback
